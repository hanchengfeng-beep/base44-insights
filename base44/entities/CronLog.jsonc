{
  "name": "CronLog",
  "type": "object",
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "\u65e5\u5fd7\u8bb0\u5f55\u65f6\u95f4"
    },
    "message": {
      "type": "string",
      "description": "\u65e5\u5fd7\u6d88\u606f\u5185\u5bb9"
    },
    "level": {
      "type": "string",
      "enum": [
        "INFO",
        "DEBUG",
        "ERROR"
      ],
      "default": "INFO",
      "description": "\u65e5\u5fd7\u7ea7\u522b"
    }
  },
  "required": [
    "timestamp",
    "message"
  ]
}